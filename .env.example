# Copy to .env (git-ignored). All optional: Simulated mode needs none of these.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
FAL_KEY=
# Hosted (Vercel) only: if set, API providers require this passcode (protects your credits).
LIVE_PASSCODE=
# Local GPU
DIFFUSERS_MODEL=stabilityai/sdxl-turbo
DIFFUSERS_TAESD=
DIFFUSERS_DEVICE=cuda
# Tuning
LIVE_MAX_STEPS=60
LIVE_MAX_PIXELS=1572864
LIVE_SIM_STEP_MS=120
